rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }
    function isChatMember(chatId) {
      return signedIn()
        && exists(chatPath(chatId))
        && request.auth.uid in get(chatPath(chatId)).data.members;
    }

    // Private account data: only the account owner can access it.
    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // Public driver profile: never store private email or phone here.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','userId','name','city','bio','photoURL','updatedAt']);
      allow delete: if isOwner(uid);
    }

    // Signed-in drivers can see live drivers; each driver writes only their own presence.
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','city','lat','lng','accuracy','sharing','status','updatedAt'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.sharing == true
        && request.resource.data.status == 'online';
      allow delete: if isOwner(uid);
    }

    // Allow signed-in users to check whether a deterministic chat ID exists,
    // but only members can read an existing conversation.
    match /chats/{chatId} {
      allow get: if signedIn()
        && (!exists(chatPath(chatId)) || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(['members','memberNames','lastMessage','updatedAt','createdAt']);
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt','memberNames']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['senderUid','text','createdAt']);
        allow update, delete: if false;
      }
    }

    // A driver can see block records where they are either party, enabling
    // the chat UI to respect blocks without exposing unrelated block records.
    match /blocks/{blockId} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.keys().hasOnly(['ownerUid','blockedUid','createdAt']);
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly(['reporterUid','reportedUid','chatId','reason','createdAt','status']);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
