rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function validLocation(loc) {
      return loc == null || (loc is map && loc.keys().hasAll(['lat', 'lng']) &&
        loc.lat is number && loc.lng is number && loc.lat >= -90 && loc.lat <= 90 &&
        loc.lng >= -180 && loc.lng <= 180 &&
        (!('address' in loc) || loc.address is string) &&
        (!('source' in loc) || loc.source in ['gps', 'map']));
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Unique, user-chosen Driver IDs. A reservation can only be created once.
    match /driverIds/{driverId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.userId == driverId &&
        request.resource.data.keys().hasOnly(['uid', 'userId', 'createdAt']);
      allow update, delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly(['uid','userId','name','city','shift','bio','phone','photoURL','onlineStatus','savedLocation','updatedAt']) &&
        (!('shift' in request.resource.data) || request.resource.data.shift in ['day','night','24h']) &&
        (!('onlineStatus' in request.resource.data) || request.resource.data.onlineStatus in ['online','offline']) &&
        (!('savedLocation' in request.resource.data) || validLocation(request.resource.data.savedLocation));
      allow delete: if isOwner(uid);
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly(['uid','name','city','lat','lng','accuracy','sharing','status','updatedAt']) &&
        request.resource.data.lat is number && request.resource.data.lng is number &&
        request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
        request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
        request.resource.data.sharing == true && request.resource.data.status == 'online';
      allow delete: if isOwner(uid);
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/chats/$(chatId)) || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members is list && request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members && request.resource.data.keys().hasOnly(['members','memberNames','unreadCounts','lastMessage','updatedAt','createdAt']);
      allow update: if signedIn() && request.auth.uid in resource.data.members &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt','memberNames','unreadCounts']);
      allow delete: if false;
      match /messages/{messageId} {
        function isMember() { return signedIn() && exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members; }
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
          request.resource.data.keys().hasOnly(['senderUid','text','createdAt']);
        allow update: if false;
        // Any member may clear the shared conversation history.
        allow delete: if isMember();
      }
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.blockedUid is string && request.resource.data.keys().hasOnly(['ownerUid','blockedUid','createdAt']);
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500 &&
        request.resource.data.keys().hasOnly(['reporterUid','reportedUid','chatId','reason','createdAt','status']);
      allow read, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
